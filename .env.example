# ============================================================
# LifeSteal Phantom — environment template
# Copy to .env and fill every value. NEVER commit .env
# Generate secrets with:  openssl rand -hex 64
# ============================================================

NODE_ENV=production
TZ=UTC

# ---------- Public URLs ----------
WEB_ORIGIN=https://lifestealphantom.com
API_ORIGIN=https://api.lifestealphantom.com
COOKIE_DOMAIN=.lifestealphantom.com

# ---------- API ----------
API_PORT=4000
TRUST_PROXY=1

# ---------- Database ----------
POSTGRES_USER=phantom
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=lifesteal_phantom
DATABASE_URL=postgresql://phantom:change_me_strong_password@postgres:5432/lifesteal_phantom?schema=public&connection_limit=20&pool_timeout=20

# ---------- Redis ----------
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379

# ---------- Auth secrets (64+ hex chars each, all different) ----------
JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_64
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_64
COOKIE_SECRET=replace_with_openssl_rand_hex_64
ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ---------- Mail (SMTP) ----------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=change_me
MAIL_FROM="LifeSteal Phantom <no-reply@lifestealphantom.com>"

# ---------- Minecraft ----------
MC_HOST=play.lifestealphantom.com
MC_PORT=25565
MC_QUERY_PORT=25565
MC_RCON_HOST=mc
MC_RCON_PORT=25575
MC_RCON_PASSWORD=change_me_rcon
# Shared secret used by the in-game plugin to push stats to the API
PLUGIN_API_KEY=replace_with_openssl_rand_hex_32

# ---------- Payments ----------
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STORE_CURRENCY=USD

# ---------- Anti-bot ----------
TURNSTILE_SECRET_KEY=change_me
NEXT_PUBLIC_TURNSTILE_SITE_KEY=change_me

# ---------- Backups ----------
BACKUP_DIR=/var/backups/phantom
BACKUP_RETENTION_DAYS=14
BACKUP_CRON=0 3 * * *

# ---------- Frontend (build-time) ----------
NEXT_PUBLIC_API_URL=https://api.lifestealphantom.com
NEXT_PUBLIC_SITE_URL=https://lifestealphantom.com
NEXT_PUBLIC_SERVER_IP=play.lifestealphantom.com
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/phantom
